# Local Windows development settings. Render supplies PORT automatically.
REDLINE_HOST=127.0.0.1
REDLINE_PORT=8000
REDLINE_POLL_SECONDS=600
REDLINE_ADMIN_TOKEN=replace-with-a-long-random-secret
REDLINE_PROVIDERS_CONFIG=./providers.json
REDLINE_DATA_DIR=./server_data

# After adding your own domain, set this to its HTTPS origin, e.g.
# REDLINE_PUBLIC_URL=https://www.example.com

# Add API tokens only after a marketplace issues credentials.
# MASHINA_API_TOKEN=
# GARAJ_API_TOKEN=
# MYAUTO_API_TOKEN=
# TAPCAR_API_TOKEN=
# LALAFO_API_TOKEN=
# TRANSPORT_API_TOKEN=
